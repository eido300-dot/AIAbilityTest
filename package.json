{
  "name": "aiability-crm",
  "version": "0.1.0",
  "private": true,
  "description": "תשתית למערכת ניהול לקוחות רב־עסקית ולניסוי פיתוח מתועד בעזרת בינה מלאכותית",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait database",
    "db:stop": "docker compose stop database",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "predev": "npm run build -w @crm/database",
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @crm/api\" \"npm run dev -w @crm/web\"",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build -w @crm/database",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build -w @crm/database",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
